# SelfUp Android app — copy to .env and fill in, then restart `npx expo start`.
# These are inlined into the app at build time, so they must be public values:
# never put the Supabase service-role key here.

# Same values as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY in web/.env.local
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# The SelfUp website the app syncs through (its /api routes). No trailing slash.
# Production: https://your-domain.com
# Local dev on a real phone: your computer's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL="https://your-domain.com"
